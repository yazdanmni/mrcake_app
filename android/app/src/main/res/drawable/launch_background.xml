<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch background.

     The default Flutter splash (a plain white window) is replaced by the
     Mr. Cake brand colour so the transition from the OS window to the Dart
     splash screen is seamless: no white flash, no Flutter logo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
</layer-list>
